[Unit]
Description=TechGeekPH Client Network Ping Monitor
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/techgeekph-network-monitor.env
ExecStart=/usr/bin/python3 /opt/techgeekph-network-monitor/network-monitor-agent.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
