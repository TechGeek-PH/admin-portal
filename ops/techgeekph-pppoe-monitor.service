[Unit]
Description=TechGeekPH MikroTik PPPoE Sync
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/techgeekph-network-monitor.env
EnvironmentFile=/etc/techgeekph-pppoe-monitor.env
ExecStart=/usr/bin/python3 /opt/techgeekph-network-monitor/mikrotik-pppoe-sync.py
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
